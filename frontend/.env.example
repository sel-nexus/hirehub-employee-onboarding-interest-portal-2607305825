# Vite dev/preview and Playwright webServer bind host; no API or secrets.
HOST=localhost
# Vite dev/preview and Playwright webServer port; strictPort prevents drift.
PORT=4173
# Playwright target origin. Keep aligned with HOST/PORT for the local webServer.
# Omit BASE_URL to derive http://HOST:PORT; override to test an existing server.
BASE_URL=http://localhost:4173
